# Server Port
PORT=8000

# Better Auth Shared Secret (must match assignment_09_client BETTER_AUTH_SECRET)
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Frontend Application URL (used for CORS and Stripe success/cancel redirects)
BETTER_AUTH_URL=http://localhost:3000

# Backend API Base URL
API_BASE_URL=http://localhost:8000

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=WedPlan

# Stripe Payment Integration (Test Mode — Keep strictly on server!)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
